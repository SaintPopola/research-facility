#!/bin/sh
# Sweet Melody (Research Facility) - samples-component postinstall.
# The installer runs as root ($HOME = /var/root), so resolve the REAL logged-in
# user and write a per-user LinkOSX that points HISE at the shared sample folder
# this installer just placed under /Library. Result: no locate dialog, ever.
set -e

# Canonical (shared, all-user) sample location installed by the samples pkg.
SYS="/Library/Application Support/Research Facility/Sweet Melody/Samples"

# Resolve the console user (Apple/scriptingosx-verified method).
loggedInUser=$( echo "show State:/Users/ConsoleUser" | scutil | awk '/Name :/ && ! /loginwindow/ { print $3 }' )
if [ -z "$loggedInUser" ] || [ "$loggedInUser" = "root" ]; then
  loggedInUser=$( stat -f "%Su" /dev/console )
fi
userHome=$( dscl . -read /Users/"$loggedInUser" NFSHomeDirectory 2>/dev/null | awk '{print $2}' )
[ -z "$userHome" ] && userHome="/Users/$loggedInUser"

APP="$userHome/Library/Application Support/Research Facility/Sweet Melody/Samples"
mkdir -p "$APP"
# LinkOSX = single line, absolute path, no trailing newline (HISE reads it verbatim).
printf '%s' "$SYS" > "$APP/LinkOSX"

# Hand the created AppData tree back to the user (installer created it as root).
chown -R "$loggedInUser":staff "$userHome/Library/Application Support/Research Facility" 2>/dev/null || true

# v0.2 rename: the plugin is now "Sweet Melody" with the SAME plug-in IDs, so the
# old ResearchFacility bundles must go or hosts would see two copies of one UID.
rm -rf "/Library/Audio/Plug-Ins/VST3/ResearchFacility.vst3" "/Library/Audio/Plug-Ins/Components/ResearchFacility.component" 2>/dev/null || true
if [ -n "$userHome" ]; then
  rm -rf "$userHome/Library/Audio/Plug-Ins/VST3/ResearchFacility.vst3" "$userHome/Library/Audio/Plug-Ins/Components/ResearchFacility.component" 2>/dev/null || true
fi
exit 0
